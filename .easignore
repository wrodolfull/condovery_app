# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Build configuration and private provider credentials
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
*.p8
*.jks
*.keystore

# Browser preview checks
/test-results/
/playwright-report/

# EAS local build: include the Android Firebase client configuration even though
# it is intentionally excluded from Git. Never include FCM service account keys.
# See docs.expo.dev/build-reference/easignore/
!google-services.json
